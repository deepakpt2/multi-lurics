# Copy to .env. Percent-encode special characters in passwords (e.g. @ -> %40).
# The database name MUST start with "lyrics_" (startup refuses anything else).
LYRICS_DATABASE_URL=postgres://user:password@localhost:5432/lyrics_dev
# Used by `make test`/sqlx::test; each test gets its own throwaway database.
LYRICS_TEST_DATABASE_URL=postgres://user:password@localhost:5432/lyrics_test
LYRICS_APP_BASE_URL=http://localhost:3000
LYRICS_BIND_ADDR=127.0.0.1:8787
# Optional
# LYRICS_SESSION_TTL_HOURS=336
# LYRICS_COOKIE_SECURE=true          # set false only for plain-http local dev
# LYRICS_DB_MAX_CONNECTIONS=10
# LYRICS_DEV_MAILBOX_DIR=.mailbox    # worker writes emails here instead of sending
# LYRICS_SEARCH_RATE_PER_MIN=120     # typeahead requests per client per minute
# LYRICS_LOG_JSON=1
# RUST_LOG=info,sqlx=warn
