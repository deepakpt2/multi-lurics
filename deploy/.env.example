# Copy to deploy/.env on the server and edit. deploy/.env is gitignored,
# so `git pull` never overwrites it and docker-compose.yml never needs editing.

# --- Compose ---
# Prefix for container, volume and network names. Keep it stable: changing it means new (empty) volumes.
COMPOSE_PROJECT_NAME=community-lyrics
IMAGE_PREFIX=community-lyrics
IMAGE_TAG=latest

# --- Public endpoint (Cloudflare tunnel → Traefik → web) ---
APP_DOMAIN=lyrics.example.com
# Used in email links. https because Cloudflare terminates TLS.
APP_PUBLIC_URL=https://lyrics.example.com

# --- Traefik ---
# Existing external Docker network Traefik is attached to.
PROXY_NETWORK=proxy
# Traefik entrypoint for plain HTTP (no TLS settings here; Cloudflare handles TLS).
TRAEFIK_ENTRYPOINT=web
# Router/service name; must be unique among all stacks on this Traefik.
TRAEFIK_ROUTER=lyrics

# --- Database ---
POSTGRES_VERSION=17
POSTGRES_USER=lyrics
# URL-safe characters only (letters, digits). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Must start with "lyrics_" (the app refuses anything else).
POSTGRES_DB=lyrics_prod

# --- App ---
# true: browsers reach the site over https via Cloudflare. Use false only for plain-http access (e.g. by LAN IP).
COOKIE_SECURE=true
SESSION_TTL_HOURS=336
DB_MAX_CONNECTIONS=10
LOG_JSON=1
RUST_LOG=info,sqlx=warn
# Real email: set both SMTP_URL (smtp://host:25 or smtps://user:pass@host:465, percent-encode the
# password) and MAIL_FROM (e.g. "Lyrics <no-reply@example.com>"). Leave both empty to use the mailbox below.
SMTP_URL=
MAIL_FROM=
# Without SMTP, set this and the worker writes each email (including verification and reset links) to a file:
#   docker compose -f deploy/docker-compose.yml exec worker sh -c 'cat /data/mailbox/*.json'
# Leave empty to only log that an email event happened.
MAILBOX_DIR=/data/mailbox

# --- First administrator ---
# Created (or promoted, if the address already has an account) every time the API starts. An existing
# account keeps its own password. Password: at least 12 characters. Remove ADMIN_PASSWORD from this file
# after the first start if you prefer; the account stays.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Sign in with Google (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application).
# Authorized redirect URI: <APP_PUBLIC_URL>/api/v1/auth/google/callback
# Leave both empty to offer email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public pages (SEO) ---
# Shared secret for cache invalidation: the worker calls web's /api/revalidate with it when lyrics are
# published or a page URL changes. At least 16 characters. Generate: openssl rand -hex 24
# Leave empty to disable (pages then refresh only after their 5 minute cache expires).
REVALIDATE_SECRET=

# --- Operations ---
# Bearer token for the API's /metrics endpoint (Prometheus). At least 16 characters; empty disables the
# endpoint (it answers 404). It is never routed through web: scrape http://api:8787/metrics inside the
# compose network. Generate: openssl rand -hex 24
METRICS_TOKEN=
# Per client and minute: login/registration/password reset/legal notices, and typeahead.
AUTH_RATE_PER_MIN=20
SEARCH_RATE_PER_MIN=120
# Image uploads (stored on the `media` volume). Largest upload in bytes, largest width/height in pixels,
# and the square sizes generated for every image. Back the volume up with the database.
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_SIDE=8000
MEDIA_SIZES=96,240,640
